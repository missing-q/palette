{{! Palette Tab }}
<section
  class='tab palette scrollable {{tab.cssClass}}'
  data-group='primary'
  data-tab='palette'
>

  <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'Name'}}</div>
      <div class='item-controls'>
        {{#if (eq actor.type 'npc')}} {{! item create/delete controls should only be shown when it's an NPC}}
          <a
            class='item-control item-create'
            data-tooltip='{{localize "DOCUMENT.Create" type='Item'}}'
            data-action='createDoc'
            data-document-class='Item'
            data-type='hue'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='item'}}
          </a>
        {{/if}}
      </div>
    </li>
    {{#each hues as |item id|}}
      <li
        class='item flexrow draggable'
        data-item-id='{{item._id}}'
        data-document-class='Item'
      >
        <div class='item-name'>
          <div class='item-image {{item.system.color}}'>
          </div>
          <div>{{item.name}}</div>
        </div>
        <div class='item-formula item-prop'>{{item.system.description}}</div>
        <div class='item-controls'>
          <a
            class='item-control item-edit'
            data-tooltip='{{localize "DOCUMENT.Update" type='Hue'}}'
            data-action='viewDoc'
          >
            <i class='fas fa-edit'></i>
          </a>
          {{#if (eq actor.type 'npc')}}
            <a
              class='item-control item-delete'
              data-tooltip='{{localize "DOCUMENT.Delete" type='Hue'}}'
              data-action='deleteDoc'
            >
              <i class='fas fa-trash'></i>
            </a>
          {{/if}}
        </div>
      </li>
    {{/each}}
  </ol>

  {{! Hand}}
  {{#unless system.hand.locked}}
    <ol class='items-list'>
    <li class='item flexrow items-header'>
      <div class='item-name'>{{localize 'PALETTE.Actor.base.FIELDS.hand.label'}}</div>
      <div class='item-controls'>
        <select class = "hand-select">
          {{selectOptions config.colorMap selected="selected" localize=true}}
        </select>
        <a 
          class='item-control item-create'
          data-action='addHand'
        >
          <i class='fas fa-plus'></i>
        </a>
      </div>
    </li>
    {{#each system.hand.value}}
      <li
        class='item flexrow draggable'
      >
        <div class='item-name'>
          <img class='item-image' src='systems/palette/assets/icon-{{this}}.svg' height="24" width="24"/>
        </div>
        <div class='item-controls'>
          <a
            class='item-control item-delete'
            data-action='deleteHand'
            data-index='{{@index}}'
          >
            <i class='fas fa-trash'></i>
          </a>
        </div>
      </li>
    {{/each}}
  </ol>
  {{/unless}}

</section>