{{! Sheet Header }}
<header class='sheet-header'>
  <img
    class='profile-img'
    src='{{actor.img}}'
    data-edit='img'
    data-action='onEditImage'
    data-tooltip='{{actor.name}}'
    height='100'
    width='100'
  />
  <div class='header-fields'>
    <div class='document-name'>
      <input
        name='name'
        type='text'
        value='{{actor.name}}'
        placeholder='Name'
      />
    </div>
    {{! The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  }}
    <div class='resources grid grid-3col'>

      {{! "flex-group-center" is also defined in the _grid.scss file
        and it will add a small amount of padding, a border, and will
        center all of its child elements content and text. }}

      {{! Stress values}}
      <div class='resource flex-group-center'>
        <label for='system.attributes.stress.value' class='resource-label'>
          {{localize 'PALETTE.Actor.base.FIELDS.stress.value.label'}}
        </label>
        <div class='resource-content flexrow flex-center flex-between'>
          <input
            type='text'
            name='system.stress.value'
            value='{{system.attributes.stress.value}}'
            data-dtype='Number'
          />
          <span> / </span>
          <input
            type='text'
            name='system.attributes.stress.max'
            value='{{system.attributes.stress.max}}'
            data-dtype='Number'
          />
        </div>
      </div>

      {{! Movement values}}
      <div class='resource flex-group-center'>
        <div class='resource-content flexrow flex-center flex-between'>
          <label for='system.attributes.move.speed' class='resource-label'>
            {{localize 'PALETTE.Actor.base.FIELDS.move.speed.label'}}
          </label>

          <label for='system.attributes.move.jump' class='resource-label'>
            {{localize 'PALETTE.Actor.base.FIELDS.move.jump.label'}}
          </label>
        </div>

        <div class='resource-content flexrow flex-center flex-between'>
          <input
            type='text'
            name='system.attributes.move.speed'
            value='{{system.attributes.move.speed}}'
            data-dtype='Number'
          />
          
          <input
            type='text'
            name='system.attributes.move.jump'
            value='{{system.attributes.move.jump}}'
            data-dtype='Number'
          />
        </div>
        
      </div>
      
      {{! Tier and DN values}}
      <div class='resource flex-group-center'>
        <div class='resource-content flexrow flex-center flex-between'>
          <label for='system.attributes.tier' class='resource-label'>
            {{localize 'PALETTE.Actor.base.FIELDS.tier.label'}}
          </label>

          <label for='system.attributes.dn' class='resource-label'>
            {{localize 'PALETTE.Actor.base.FIELDS.dn.label'}}
          </label>
        </div>

        <div class='resource-content flexrow flex-center flex-between'>
          <input
            type='text'
            name='system.attributes.tier'
            value='{{system.attributes.tier}}'
            data-dtype='Number'
          />

          <input
            type='text'
            name='system.attributes.dn'
            value='{{system.attributes.dn}}'
            data-dtype='Number'
          />
        </div>
        
      </div>





    </div>
  </div>
</header>