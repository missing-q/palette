<div class="color-dice-roll">
  <header class="color-dice-header">
    <span class="formula">{{formula}}</span>
    <span class="success-count">{{successCount}} / {{diceCount}} hits</span>
  </header>

  {{#if successColors.length}}
  <div class="target-colors">
    Target colors:
    {{#each successColors}}
      <span class="swatch small color-{{this}}" title="{{this}}"></span>
    {{/each}}
  </div>
  {{/if}}

  <div class="color-dice-faces">
    {{#each faces}}
    <span class="face-label">{{localize this.label}}</span>
    {{/each}}
  </div>
</div>

